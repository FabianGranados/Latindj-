---
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo-latin-claro.png';
import Icono from './Icono.astro';
import { servicios } from '../lib/paginas';
import { NEGOCIO, LINEAS, REDES, formatear, whatsapp } from '../data/contacto';
const lista = await servicios();
const anio = new Date().getFullYear();
---
<footer class="border-divider bg-bg mt-24 border-t">
  <div class="contenedor grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <a href="/" aria-label="Latin Audiovisuales — Inicio" class="inline-block">
        <Image src={logo} alt="Logo Latin DJ" width={150} densities={[1, 2]} class="h-auto w-[150px]" />
      </a>
      <p class="text-text-muted mt-5 max-w-sm">
        Mobiliario, sonido e iluminación, pistas de baile LED y pantallas para eventos sociales y empresariales en Bogotá.
      </p>
      <ul class="mt-6 flex gap-2" aria-label="Redes sociales">
        {REDES.map((r) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener" aria-label={r.nombre} class="border-border text-text-muted hover:border-accent hover:text-accent inline-flex h-12 w-12 items-center justify-center rounded-full border transition-colors">
              <Icono nombre={r.icono} class="h-5 w-5" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label="Servicios">
      <h2 class="etiqueta mb-4">Alquileres</h2>
      <ul class="space-y-1">
        {lista.map((s) => (
          <li><a href={s.ruta} class="text-text-muted hover:text-accent inline-flex min-h-11 items-center">{s.nombre}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="etiqueta mb-4">Contacto</h2>
      <p class="text-text-muted flex gap-2">
        <Icono nombre="ubicacion" class="text-accent mt-0.5 h-5 w-5 shrink-0" />
        <span>{NEGOCIO.direccion} · {NEGOCIO.ciudad}</span>
      </p>
      <ul class="mt-3 space-y-1">
        {LINEAS.map((l) => (
          <li>
            <a href={whatsapp(undefined, l.numero)} target="_blank" rel="noopener" class="text-text hover:text-accent inline-flex min-h-11 items-center gap-2 font-semibold">
              <Icono nombre="whatsapp" class="text-accent h-5 w-5" /> {formatear(l.numero)}
            </a>
          </li>
        ))}
      </ul>
      <a href="/contactanos/" class="text-accent hover:text-accent-hover mt-2 inline-flex min-h-11 items-center gap-1 font-bold">
        Ir a contacto <Icono nombre="flecha" class="h-4 w-4" />
      </a>
    </div>
  </div>
  <div class="border-divider border-t">
    <div class="contenedor text-text-subtle flex flex-col gap-2 py-6 text-sm sm:flex-row sm:justify-between">
      <p>© {anio} {NEGOCIO.nombre}. Todos los derechos reservados.</p>
      <p>ltndj.com</p>
    </div>
  </div>
</footer>
