{nombre === 'izquierda' && <svg class={clase} viewBox="0 0 24 24" {...trazo} aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>}
{nombre === 'derecha' && <svg class={clase} viewBox="0 0 24 24" {...trazo} aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>}
{nombre === 'play' && <svg class={clase} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5Z"/></svg>}
{nombre === 'ubicacion' && <svg class={clase} viewBox="0 0 24 24" {...trazo} aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>}
{nombre === 'montaje' && <svg class={clase} viewBox="0 0 24 24" {...trazo} aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6Z"/></svg>}
