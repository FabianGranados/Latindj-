}
const { nombre, class: clase = 'h-5 w-5' } = Astro.props;
const trazo = { fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
