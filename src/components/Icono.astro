    | 'whatsapp' | 'instagram' | 'facebook' | 'youtube' | 'flickr' | 'linkedin'
    | 'menu' | 'cerrar' | 'flecha' | 'play' | 'ubicacion' | 'chevron' | 'izquierda' | 'derecha'
    | 'montaje' | 'eventos' | 'audio' | 'chat';
