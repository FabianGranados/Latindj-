---
import TarjetaServicio from './TarjetaServicio.astro';
import type { Servicio } from '../lib/paginas';
interface Props { servicios: Servicio[] }
const { servicios } = Astro.props;
---
<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {servicios.map((s) => <li class="flex"><TarjetaServicio servicio={s} /></li>)}
</ul>
