---
import Icono from './Icono.astro';
import { whatsapp, PRINCIPAL, formatear, MENSAJES } from '../data/contacto';
interface Props { mensaje?: string }
const { mensaje = MENSAJES.general } = Astro.props;
---
<section class="contenedor mt-24" aria-labelledby="cta-titulo">
  <div class="bg-accent text-on-accent relative overflow-hidden rounded-[28px] px-6 py-12 sm:px-12 sm:py-14 md:flex md:items-center md:justify-between md:gap-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full bg-white/15 blur-3xl"></div>
    <div class="relative">
      <h2 id="cta-titulo" class="h2">¿Tienes un evento en mente?</h2>
      <p class="mt-3 text-lg font-medium">Escríbenos y te enviamos tu cotización hoy mismo.</p>
    </div>
    <a href={whatsapp(mensaje)} target="_blank" rel="noopener" class="btn btn-dark relative mt-8 shrink-0 md:mt-0">
      <Icono nombre="whatsapp" class="text-whatsapp h-5 w-5" /> WhatsApp {formatear(PRINCIPAL.numero)}
    </a>
  </div>
</section>
